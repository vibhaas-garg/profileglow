# ===================================================
# ProfileGlow Environment Variables
# ===================================================

# 1. Google Gemini API (Multimodal Vision & Language)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# 2. Firebase Client Configuration (Web SDK)
# Get these in Firebase Console -> Project Settings -> General -> Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyMockKeyForDevOnly_1234567890"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="profileglow-dev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="profileglow-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="profileglow-dev.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

# 3. Firebase Admin Configuration (Server SDK)
# Optional: Get this service account JSON from Firebase Console -> Service accounts
FIREBASE_PROJECT_ID="profileglow-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@profileglow-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""

# 4. Razorpay Payments (UPI, Cards, Netbanking)
# Get keys from Razorpay Dashboard -> Settings -> API Keys (Test Mode available)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_mock_key_id"
RAZORPAY_KEY_SECRET="mock_key_secret_12345"
